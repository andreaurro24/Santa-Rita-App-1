{
  "name": "Santa Rita · confirmar-borrador",
  "nodes": [
    {
      "id": "n32",
      "name": "Telegram: botón",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "updates": [
          "callback_query"
        ],
        "additionalFields": {}
      },
      "credentials": {
        "telegramApi": {
          "id": "CAMBIAR",
          "name": "Telegram Santa Rita"
        }
      },
      "webhookId": "santa-rita-botones"
    },
    {
      "id": "n33",
      "name": "Leer botón",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const q = $input.first().json.callback_query;\nconst [accion, id] = String(q.data || '').split(':');\nconst sql = accion === 'r'\n  ? \"select campo.rechazar_borrador($1::uuid, $2::bigint, 'rechazado desde Telegram') as resultado\"\n  : 'select campo.confirmar_y_cargar($1::uuid, $2::bigint, ' + (accion === 'd' ? 'true' : 'false') + ') as resultado';\nreturn [{ json: { accion, id, user_id: q.from.id, chat_id: q.message.chat.id, query_id: q.id, sql } }];"
      }
    },
    {
      "id": "n34",
      "name": "Supabase: confirmar o rechazar",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        480,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "={{ $json.sql }}",
        "options": {
          "queryReplacement": "={{ [$json.id, $json.user_id] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "CAMBIAR",
          "name": "Supabase arnes_campo"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "n35",
      "name": "Armar respuesta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const b = $('Leer botón').first().json;\nconst r = $input.first().json;\nlet texto;\nif (r.error) texto = 'No se cargó nada: ' + String(r.error.message || r.error).replace(/^.*?: /, '');\nelse if (b.accion === 'r') texto = 'Borrador rechazado. No se cargó nada.';\nelse texto = 'Listo: se cargaron ' + r.resultado + ' registros en la app.';\nreturn [{ json: { ...b, texto, ok: !r.error } }];"
      }
    },
    {
      "id": "n36",
      "name": "Telegram: responder botón",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        960,
        0
      ],
      "parameters": {
        "resource": "callback",
        "queryId": "={{ $json.query_id }}",
        "additionalFields": {
          "text": "={{ $json.texto.slice(0, 190) }}"
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "CAMBIAR",
          "name": "Telegram Santa Rita"
        }
      }
    },
    {
      "id": "n37",
      "name": "Telegram: resultado",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "chatId": "={{ $('Armar respuesta').first().json.chat_id }}",
        "text": "={{ $('Armar respuesta').first().json.texto }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "CAMBIAR",
          "name": "Telegram Santa Rita"
        }
      }
    },
    {
      "id": "n38",
      "name": "Bitácora: botón",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1440,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "insert into campo.bitacora_jornadas (tipo, borrador_id, telegram_user_id, detalle) values ('boton_' || $1, $2::uuid, $3, $4::jsonb)",
        "options": {
          "queryReplacement": "={{ (() => { const r = $('Armar respuesta').first().json; return [r.ok ? r.accion : r.accion + '_bloqueado', r.id, r.user_id, JSON.stringify({ texto: r.texto })]; })() }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "CAMBIAR",
          "name": "Supabase arnes_campo"
        }
      }
    }
  ],
  "connections": {
    "Telegram: botón": {
      "main": [
        [
          {
            "node": "Leer botón",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Leer botón": {
      "main": [
        [
          {
            "node": "Supabase: confirmar o rechazar",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Supabase: confirmar o rechazar": {
      "main": [
        [
          {
            "node": "Armar respuesta",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Armar respuesta": {
      "main": [
        [
          {
            "node": "Telegram: responder botón",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Telegram: responder botón": {
      "main": [
        [
          {
            "node": "Telegram: resultado",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Telegram: resultado": {
      "main": [
        [
          {
            "node": "Bitácora: botón",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
